# Firebase Configuration - Banderas MDP
# Copiar este archivo como .env.local y completar con los valores reales.
# Estos valores son públicos (NEXT_PUBLIC_*) y se exponen al cliente.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Analytics 4 / Firebase Analytics
# Requerido para que el AnalyticsProvider dispare page_view y eventos custom.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
